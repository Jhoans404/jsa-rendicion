# Backend Dockerfile
FROM node:alpine

# Install json-server globally
RUN npm install -g json-server

# Set working directory
WORKDIR /app

# Copy the database file
COPY db.json .

# Expose port 3000
EXPOSE 3000

# Run json-server with CORS enabled
CMD ["json-server", "--watch", "db.json", "--port", "3000", "--cors"]
